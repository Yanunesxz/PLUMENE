# ERP — dados sensíveis NUNCA versionados
*.FDB
*.GDB
*.fdb
*.gdb
_tools/erp-sync/.env
# Cache de bytecode do Python — gerado, nunca versionar
__pycache__/
*.pyc
# Leitor local de schema Firebird: DLLs, binários embed e scripts com paths/credenciais da máquina — nunca versionar
_tools/firebird-reader/

# Backups do banco: contem dados de cliente e hash de senha. Nunca versionar.
backups/

# ── Padrão SystemDesing v0.5.2 (templates/.gitignore) ────────────────────────
# Segredos: qualquer .env.* fica fora, menos os modelos e o .env.production do
# web (só tem variáveis VITE_ públicas da marca, lidas no build da Vercel).
.env.*
!.env.example
!apps/web/.env.production
# Certificado digital (A1 da NF-e), chaves e certificados
*.pfx
*.p12
*.pem
*.key

# Python
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
