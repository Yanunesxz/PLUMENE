# ERP Sync — variáveis de ambiente
# Copie para .env e preencha

# Caminho do banco Firebird no servidor ERP
FIREBIRD_DB_PATH=C:\caminho\para\DBCORPO-002.FDB
FIREBIRD_PASSWORD=masterkey
# Na fabrica (ERP rodando): conectar via servidor Firebird local, nao embedded
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_USER=SYSDBA

# Supabase (use service_role key para bypitar RLS)
SUPABASE_URL=https://PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# UUID da empresa no Supabase (tabela companies)
COMPANY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Envio de pedidos (app -> ERP): serie de numeracao e situacao inicial.
# SX = serie de pedidos de representante ja usada na fabrica; o numero vem do
# GEN_PEDIDO_UNIVERSAL (sequencia unica compartilhada por todas as series).
ERP_ORDER_PREFIX=SX
ERP_ORDER_GENERATOR=GEN_PEDIDO_UNIVERSAL
ERP_ORDER_SITUACAO=LIBERADO
# Status do Supabase que libera o envio (padrao: approved)
ERP_PUSH_STATUS=approved
