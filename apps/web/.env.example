# Tudo que começa com VITE_ vai para o navegador e qualquer pessoa lê.
# Só o que é público de propósito. Chave secreta fica na API (apps/api/.env).
VITE_API_URL=http://localhost:3001

# ── Marca desta instalação (ver src/lib/marca.ts) ────────────────────────────
# Tudo opcional: sem nada definido, a instalação é a Corpo Sensual.
# No Vercel de outra marca (ex.: PLUMENE), definir:
# VITE_BRAND_NAME=PLUMENE
# VITE_BRAND_COLOR=#0f766e
# VITE_BRAND_SUPPORT_WHATSAPP=5532999999999
# VITE_BRAND_SUPPORT_WHATSAPP_LABEL=(32) 9 9999-9999
# VITE_BRAND_CONTROL_EXPORT=false
# VITE_BRAND_UPDATE_BANNER=false
