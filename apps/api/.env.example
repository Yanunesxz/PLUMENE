# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS
CORS_ORIGIN=http://localhost:5173

# ── Onboarding de nova fábrica ───────────────────────────────────────────────
# Protege POST /companies/onboard, que cria uma empresa nova (ver
# docs/NOVA-FABRICA.md). Sem esta chave a rota fica fechada. Use um valor longo
# e aleatório: quem tiver ela cria empresa na plataforma.
PLATFORM_ONBOARD_KEY=

# ── ERP Firebird (preencher para ativar sync real) ──────────────────────────
# IP/hostname do servidor Firebird 2.5 na rede interna
ERP_DB_HOST=192.168.1.10
ERP_DB_PORT=3050
# Caminho do .FDB no SERVIDOR (não na máquina local)
ERP_DB_PATH=C:\DADOS\DBCORPO-002.FDB
ERP_DB_USER=SYSDBA
ERP_DB_PASSWORD=masterkey
# Intervalo do full sync em minutos (padrão 5)
ERP_SYNC_INTERVAL_MIN=5
# Defina true para ativar o sync automático
ERP_SYNC_ENABLED=false

# ── API de Parceiro (integração ERP externa) ─────────────────────────────────
# JSON com as chaves dos parceiros. Cada chave é amarrada a uma empresa.
# PARTNER_API_KEYS=[{"name":"fabrica","key":"<chave>","company_id":"<uuid>"}]
PARTNER_API_KEYS=

# ── Nomes que o código já lê e faltavam aqui (padrão SystemDesing v0.5.2) ──
# Tudo abaixo fica SÓ no servidor (Railway). Nunca com prefixo VITE_.
# Preencha só no .env / painel do Railway, nunca neste arquivo.

# E-mail de saída
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=

# Endereço público do app (links em e-mail e no WhatsApp)
APP_PUBLIC_URL=
APP_URL=

# IA (opcional)
IA_PROVEDOR=
IA_MODELO=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODELO=

# Avisos no celular (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
