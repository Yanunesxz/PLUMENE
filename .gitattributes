# Auto detect text files and perform LF normalization
* text=auto

# Binarios: nunca normalizar fim de linha.
# Sem isso o git pode classificar um binario como texto (ex.: PDF pequeno sem
# byte NUL no inicio) e injetar CRLF no checkout, corrompendo o arquivo.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.xlsx binary
*.docx binary
